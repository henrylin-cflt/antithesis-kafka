{
    "bootstrap_servers": "kafka-1:9092,kafka-2:9092,kafka-3:9092",
    "enable_debug": false,
    "is_strict": true,
    "log_dir": "logs",
    "consumer_isolation_level": "read_committed",
    "topic_count": {
        "min": 1,
        "max": 2
    },
    "topic_partition_count": {
        "min": 1,
        "max": 2
    },
    "producer_count": {
        "min": 1,
        "max": 4
    },
    "producer_startup_delay_ms": {
        "min": 0,
        "max": 15000
    },
    "producer_unique_sequence_count": {
        "min": 10,
        "max": 20
    },
    "producer_sequence_length": {
        "min": 1,
        "max": 5
    },
    "producer_sequence_delay_ms": {
        "min": 0,
        "max": 10
    },
    "consumer_group_count": {
        "min": 1,
        "max": 3
    },
    "consumer_group_members_count": {
        "min": 4,
        "max": 8
    },
    "consumer_group_member_startup_delay_ms": {
        "min": 0,
        "max": 120000
    },
    "consumer_group_member_process_delay_ms": {
        "min": 0,
        "max": 200
    },
    "enable_transactions": true
}